# Eve's existing Circle wallets — do not mint a second agent wallet.
# Agent SCA (EVE_PAYTO), already on Arc:
KEEPER_AGENT_WALLET=0x80aa1fA83F7B771BF2AB815DA9bA1236b1B91E3F
# Arc Facilitator receive (EVE_CIRCLE_PAYTO):
X402_PAYTO=0x0e56d191219fa7a4a8a50d17d4ce838e80bf566e
USYC_ADDRESS=0x8a5D989Bbb96929F689B0200f435f53dA42bF490
FOLIO_TREASURY=0xd47B04A41b3734EAb2687ef01d07881D05F9215e
FOLIO_DISTRIBUTOR=0xf2815231F61A1A0cBA8BCDCBA41b22c26Ca4cB25
# Arc's official RPC. rpc.arc-scan.org and the baracat mirror went down on 2026-09-30.
ARC_RPC=https://rpc.mainnet.arc.io

# x402. Unpaid calls 402. Settle runs when CIRCLE_API_KEY or X402_SELLER_PRIVATE_KEY is set.
# Seller key must control X402_PAYTO. Do not commit it.
X402_NAV_PRICE=0.01
X402_DISTRIBUTIONS_PRICE=0.05
# Also used server-side by /v1/borrowKit to attach the Borrow Kit origination fee
# (register it once: node --env-file=.env.local scripts/borrow/set-integrator-fee.mjs).
# Format <ENV>_API_KEY:<keyId>:<keySecret>. Never NEXT_PUBLIC_.
CIRCLE_API_KEY=
X402_SELLER_PRIVATE_KEY=

# Circle Earn Kit (optional; without a key, Earn shares a rate limit)
EARN_CHAIN=Arc

# Onramp. Sandbox first. A sandbox key will not work on the production host.
# Leave ONRAMP_API_KEY empty until a sandbox key exists. Do not reuse CIRCLE_API_KEY.
ONRAMP_API_KEY=
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
ONRAMP_REFERRER_DOMAIN=www.stonkfolio.me

# Jessica Air keeper. 0 = read-only tick.
KEEPER_LIVE=0

# Creator cut: 10% of launch-fee USDC to the creator wallet (scripts/keeper/cycle.mjs).
# Contract(s) that pay launch fees to the keeper. Fill after launch from ledger.topSenders
# in data/keeper-status.json. Blank = no cut planned yet (inflows are still recorded).
FEE_SOURCES=
# First block the ledger counts. Only read when data/keeper-ledger.json is created.
# Blank = the block of the first tick. The public RPC prunes logs older than about a day.
LEDGER_START_BLOCK=
# Archive RPC for eth_getLogs, if the ledger ever falls more than a day behind.
ARC_LOGS_RPC=
