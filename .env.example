# Dinari partner API — sandbox keys from https://partners.dinari.com
# Paste real values in .env.local (gitignored). Never prefix with NEXT_PUBLIC_.
# Sandbox stock tokens are NOT on Arc (eip155:5042); they land on sandbox chains.
# For Arc dShare addresses set DINARI_ENVIRONMENT=production after KYB production keys.
DINARI_API_KEY_ID=
DINARI_API_SECRET_KEY=
DINARI_ENVIRONMENT=sandbox

# Eve's existing Circle wallets — do not mint a second agent wallet.
# Agent SCA (EVE_PAYTO), already on Arc:
KEEPER_AGENT_WALLET=0x80aa1fA83F7B771BF2AB815DA9bA1236b1B91E3F
# Arc Facilitator receive (EVE_CIRCLE_PAYTO):
X402_PAYTO=0x0e56d191219fa7a4a8a50d17d4ce838e80bf566e
USYC_ADDRESS=0x8a5D989Bbb96929F689B0200f435f53dA42bF490
FOLIO_TREASURY=0xd47B04A41b3734EAb2687ef01d07881D05F9215e
FOLIO_DISTRIBUTOR=0x75ff1625d5A94155dD436BcbEA6C09909F048881
ARC_RPC=https://rpc.arc-scan.org

# x402. Unpaid calls 402. Settle runs when CIRCLE_API_KEY or X402_SELLER_PRIVATE_KEY is set.
# Seller key must control X402_PAYTO. Do not commit it.
X402_NAV_PRICE=0.01
X402_DISTRIBUTIONS_PRICE=0.05
CIRCLE_API_KEY=
X402_SELLER_PRIVATE_KEY=

# Circle Earn Kit (optional; without a key, Earn shares a rate limit)
EARN_CHAIN=Arc

# Onramp. Sandbox first. A sandbox key will not work on the production host.
# Leave ONRAMP_API_KEY empty until a sandbox key exists. Do not reuse CIRCLE_API_KEY.
ONRAMP_API_KEY=
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
ONRAMP_REFERRER_DOMAIN=www.stonkfolio.me

# Jessica Air keeper. 0 = read-only tick.
KEEPER_LIVE=0
